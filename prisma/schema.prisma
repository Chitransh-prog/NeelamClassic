generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  mustChangePassword Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokens      RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  attempts  Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([key])
}

model SiteContent {
  id            String   @id @default(cuid())
  key           String   @unique
  draftJson     Json
  publishedJson Json
  updatedAt     DateTime @updatedAt

  @@index([key])
}

model ContentVersion {
  id           String   @id @default(cuid())
  contentKey   String
  snapshotJson Json
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([contentKey, createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  publicId     String?
  format       String?
  resourceType String   @default("image")
  width        Int?
  height       Int?
  bytes        Int?
  altText      String?
  title        String?
  category     String?
  createdAt    DateTime @default(now())
}

model ServiceCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  thumbnail   String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       ServiceItem[]
}

model ServiceItem {
  id           String          @id @default(cuid())
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Decimal?        @db.Decimal(10, 2)
  priceDisplay String?
  badge        String?
  tab          String?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([categoryId])
}

model GalleryItem {
  id         String   @id @default(cuid())
  title      String
  category   String
  mediaType  String   @default("image")
  url        String
  publicId   String?
  altText    String?
  sortOrder  Int      @default(0)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([category])
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  text       String
  stars      Int      @default(5)
  isVerified Boolean  @default(true)
  avatar     String?
  isHidden   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Course {
  id             String   @id @default(cuid())
  title          String
  duration       String
  description    String?
  modules        Json
  hasCertificate Boolean  @default(true)
  image          String?
  price          Decimal? @db.Decimal(10, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String?
  status    String   @default("New")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phone])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  email     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@index([phone])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  financialYear  String
  sequenceNumber Int
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  eventDate      DateTime?
  notes          String?
  subtotal       Decimal       @db.Decimal(10, 2)
  discountType   String        @default("flat")
  discountValue  Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  advancePaid    Decimal       @default(0) @db.Decimal(10, 2)
  balanceDue     Decimal       @default(0) @db.Decimal(10, 2)
  status         String        @default("Unpaid")
  paymentMode    String?
  isSoftDeleted  Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          InvoiceItem[]
  payments       Payment[]

  @@index([invoiceNumber])
  @@index([status])
  @@index([customerId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  paymentMode String
  reference   String?
  paymentDate DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Booking {
  id             String    @id @default(cuid())
  bookingNumber  String    @unique
  clientName     String
  clientPhone    String
  clientEmail    String?
  serviceType    String
  scheduleDate   DateTime
  scheduleTime   String?
  pickupLocation  String?
  latitude        Float?
  longitude       Float?
  distanceKm      Float?    @default(0)
  deliveryCharges Decimal   @default(0) @db.Decimal(10, 2)
  serviceAmount   Decimal   @default(0) @db.Decimal(10, 2)
  status          String    @default("Pending")
  totalAmount     Decimal   @default(0) @db.Decimal(10, 2)
  advancePaid     Decimal   @default(0) @db.Decimal(10, 2)
  balanceDue      Decimal   @default(0) @db.Decimal(10, 2)
  paymentMode     String?   @default("UPI")
  notes           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([clientPhone])
  @@index([scheduleDate])
  @@index([bookingNumber])
}

